# Firebase Admin SDK (server-side; from your Firebase project's service account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Default Storage bucket for EPUB uploads — copy from the Firebase console's
# Storage page. Format is "your-project-id.appspot.com" (older projects) or
# "your-project-id.firebasestorage.app" (newer projects).
FIREBASE_STORAGE_BUCKET=

# Firebase client SDK (browser; from your Firebase project's web app config) — auth only, never used for Firestore
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
