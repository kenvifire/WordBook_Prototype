# API key used for word-sense generation and other LLM calls.
# Works with OpenAI or any OpenAI-compatible provider (e.g. DeepSeek) --
# set OPENAI_MODEL and OPENAI_BASE_URL to match the provider.
OPENAI_API_KEY=
# Model name to use for LLM calls.
OPENAI_MODEL=gpt-4o-mini
# Chat completions endpoint. Leave unset for OpenAI's default.
# For DeepSeek: https://api.deepseek.com/chat/completions (model: deepseek-chat)
OPENAI_BASE_URL=
# Email address used to identify requests to the MyMemory translation API.
MYMEMORY_EMAIL=
# Directory where runtime data (books, cards, review logs) is stored.
WORDBOOK_DATA_DIR=data/runtime
