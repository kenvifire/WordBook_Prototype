rules_version = '2';

// This app's Firestore usage-tracking collections (ttsUsage,
// bookGenerationUsage) are written only by Cloud Functions via the Admin
// SDK, which bypasses these rules entirely — so client access is denied
// outright. No other part of this app reads/writes Firestore directly
// today.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
